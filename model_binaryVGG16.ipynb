   "source": [
    "## Hyperparameters"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "87f496dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "IMG_SIZE = (256,256)\n",
    "BATCH_SIZE = 8\n",
    "EPOCHS = 100\n",
    "LEARNING_RATE = 0.001\n",
    "DROPOUT = 0.4\n",
    "\n",
    "TRAIN_DIR = \"dataset__readytouse/train\"\n",
    "VAL_DIR = \"dataset__readytouse/validation\"\n",
    "TEST_DIR = \"dataset__readytouse/test\"\n"
   ]
  },
